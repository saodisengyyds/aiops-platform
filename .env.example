# ============================================================
#  AIOps 平台环境变量模板
#  用法：cp .env.example .env && 修改密码后 docker compose up -d
# ============================================================

# ---------- 必填：数据库密码 ----------
# root 密码（仅容器内部使用，不对外）
MYSQL_ROOT_PASSWORD=改成你的root密码
# 应用数据库密码（应用与 db 共用）
DB_PASS=改成你的应用密码

# ---------- 可选：数据库 ----------
DB_NAME=aiops
DB_USER=aiops
DB_POOL=30

# ---------- 可选：端口 ----------
# 应用对外端口
APP_HOST_PORT=8899
# 数据库映射到宿主机的端口（只绑 127.0.0.1）
DB_HOST_PORT=3307

# ---------- 可选：应用 ----------
# 镜像名（本地构建用 aiops:1.0.0，从仓库拉用 registry/aiops:1.0.0）
APP_IMAGE=aiops:1.0.0
# 平台对外地址，Agent 安装命令里会用到（反代场景务必设置）
# PUBLIC_URL=https://aiops.example.com
PUBLIC_URL=
# 会话有效期（毫秒），默认 8 小时
SESSION_TTL=28800000

# ---------- 数据目录 ----------
# 数据库数据文件持久化到宿主机此目录下（映射到容器 /var/lib/mysql）
# 默认 /data，实际使用 /data/mysql
DATA_DIR=/data
